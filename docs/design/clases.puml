@startuml
title BiblioUNSA - Diseño de sistema completo
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Adaptadores de matrícula" {
    abstract class ServicioMatricula <<Strategy>> {
        +validar_vigente(estudiante_id)
    }

    class MatriculaLegadoAdapter <<Adapter>> {
        -sdk
        +validar_vigente(estudiante_id)
    }

    class MatriculaNuevoAdapter <<Adapter>> {
        -sdk
        +validar_vigente(estudiante_id)
    }

    class FabricaMatricula <<Factory>> {
        -_creadores
        +registrar(nombre, creador)
        +crear(nombre, sdk)
    }

    class MatriculaConReintentos <<Decorator>> {
        -interno: ServicioMatricula
        -intentos
        +validar_vigente(estudiante_id)
    }
}

package "Servicios externos simulados" {
    class AcademicoLegado {
        +vigentes
        +fallas
        +llamadas
        +validar_matricula(estudiante_id)
    }

    class AcademicoNuevo {
        +vigentes
        +fallas
        +llamadas
        +obtener_estado(codigo)
    }

    class CatalogoMemoria {
        +disponibles
        +reservados
        +esta_disponible(ejemplar_id)
        +reservar_atomico(ejemplar_id)
    }
}

package "Políticas de multas" {
    abstract class PoliticaMulta <<Strategy>> {
        +calcular(dias_retraso)
    }

    class MultaEstudiante <<ConcreteStrategy>> {
        +calcular(dias_retraso)
    }

    class MultaDocente <<ConcreteStrategy>> {
        +calcular(dias_retraso)
    }

    class FabricaMultas <<Factory>> {
        -_politicas
        +registrar(tipo, politica)
        +crear(tipo)
    }
}

package "Estados del préstamo" {
    class Prestamo <<Context>> {
        -_estado
        +estado
        +cambiar_a(estado)
        +registrar_prestamo()
        +marcar_vencido()
        +calcular_multa(dias_retraso)
        +registrar_devolucion()
        +cancelar()
        +expirar()
    }

    class EstadoPrestamoBase <<State>> {
        +nombre
        +registrar_prestamo(prestamo)
        +marcar_vencido(prestamo)
        +calcular_multa(prestamo, dias_retraso)
        +registrar_devolucion(prestamo)
        +cancelar(prestamo)
        +expirar(prestamo)
    }

    class Reservado <<ConcreteState>>
    class Prestado <<ConcreteState>>
    class Vencido <<ConcreteState>>
    class ConMulta <<ConcreteState>>
    class Devuelto <<ConcreteState>>
    class Cancelado <<ConcreteState>>
    class Expirado <<ConcreteState>>
}

package "Eventos de reserva" {
    class PublicadorEventos <<Subject>> {
        -_suscriptores
        +suscribir(tipo, suscriptor)
        +publicar(tipo, datos)
    }

    class ConfirmadorReserva <<Observer>> {
        +bandeja
        +actualizar(datos)
    }

    class AuditorReserva <<Observer>> {
        +bandeja
        +actualizar(datos)
    }
}

package "Recomendación de libros con IA" {
    abstract class ProveedorLLM <<Strategy>> {
        +completar(prompt)
    }

    class ClienteLLMSimulado {
        +respuesta
        +llamadas
        +generar(texto_entrada)
    }

    class LLMAdapter <<Adapter>> {
        -cliente
        +completar(prompt)
    }

    class ProveedorConCache <<Decorator>> {
        -interno
        -_cache
        +completar(prompt)
    }

    abstract class Guardrail <<Handler>> {
        +siguiente
        +validar(texto)
        +_aplicar(texto)
    }

    class SinPreciosInventados <<ConcreteHandler>> {
        +_aplicar(texto)
    }

    class SinDisponibilidadGarantizada <<ConcreteHandler>> {
        +_aplicar(texto)
    }

    class RecomendadorLibros {
        -proveedor: ProveedorLLM
        -guardrails
        +recomendar(titulo)
    }
}

package "Servicio principal" {
    class ServicioBiblioteca {
        +proveedor
        +academico
        +catalogo
        +eventos
        +fabrica_matricula
        +fabrica_multas
        +publicador
        +reservar(estudiante_id, ejemplar_id)
        +calcular_multa(tipo_usuario, dias_retraso)
    }
}

' ===== ADAPTER Y FACTORY =====
ServicioMatricula <|-- MatriculaLegadoAdapter
ServicioMatricula <|-- MatriculaNuevoAdapter
ServicioMatricula <|-- MatriculaConReintentos

MatriculaLegadoAdapter --> AcademicoLegado : adapta
MatriculaNuevoAdapter --> AcademicoNuevo : adapta

FabricaMatricula ..> MatriculaLegadoAdapter : crea
FabricaMatricula ..> MatriculaNuevoAdapter : crea

MatriculaConReintentos o--> ServicioMatricula : interno

' ===== STRATEGY DE MULTAS =====
PoliticaMulta <|-- MultaEstudiante
PoliticaMulta <|-- MultaDocente

FabricaMultas ..> MultaEstudiante : crea
FabricaMultas ..> MultaDocente : crea
FabricaMultas ..> PoliticaMulta : devuelve

' ===== STATE =====
EstadoPrestamoBase <|-- Reservado
EstadoPrestamoBase <|-- Prestado
EstadoPrestamoBase <|-- Vencido
EstadoPrestamoBase <|-- ConMulta
EstadoPrestamoBase <|-- Devuelto
EstadoPrestamoBase <|-- Cancelado
EstadoPrestamoBase <|-- Expirado

Prestamo *--> EstadoPrestamoBase : estado actual
Prestamo ..> Reservado : estado inicial

Reservado ..> Prestado : registrar_prestamo()
Reservado ..> Cancelado : cancelar()
Reservado ..> Expirado : expirar()
Prestado ..> Vencido : marcar_vencido()
Prestado ..> Devuelto : registrar_devolucion()
Vencido ..> ConMulta : calcular_multa()
ConMulta ..> Devuelto : registrar_devolucion()

' ===== OBSERVER =====
PublicadorEventos o--> "0..*" ConfirmadorReserva : suscriptores
PublicadorEventos o--> "0..*" AuditorReserva : suscriptores

' ===== IA: ADAPTER Y DECORATOR =====
ProveedorLLM <|-- LLMAdapter
ProveedorLLM <|-- ProveedorConCache

LLMAdapter --> ClienteLLMSimulado : cliente
ProveedorConCache o--> ProveedorLLM : interno

' ===== CHAIN OF RESPONSIBILITY =====
Guardrail <|-- SinPreciosInventados
Guardrail <|-- SinDisponibilidadGarantizada

Guardrail o--> "0..1" Guardrail : siguiente
SinPreciosInventados ..> SinDisponibilidadGarantizada : siguiente por defecto

' ===== RECOMENDADOR =====
RecomendadorLibros --> ProveedorLLM : utiliza
RecomendadorLibros --> Guardrail : valida respuesta
RecomendadorLibros ..> SinPreciosInventados : crea
RecomendadorLibros ..> SinDisponibilidadGarantizada : crea

' ===== SERVICIO PRINCIPAL =====
ServicioBiblioteca --> AcademicoLegado : académico por defecto
ServicioBiblioteca --> CatalogoMemoria : catálogo
ServicioBiblioteca --> FabricaMatricula : fábrica matrícula
ServicioBiblioteca --> FabricaMultas : fábrica multas
ServicioBiblioteca --> PublicadorEventos : publica eventos

ServicioBiblioteca ..> MatriculaConReintentos : crea y utiliza
ServicioBiblioteca ..> ServicioMatricula : valida matrícula
ServicioBiblioteca ..> PoliticaMulta : calcula multa
ServicioBiblioteca ..> ConfirmadorReserva : suscribe
ServicioBiblioteca ..> AuditorReserva : suscribe

@enduml
