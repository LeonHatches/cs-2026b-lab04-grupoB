{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["historia_id", "invest_ok", "preguntas", "escenarios"],
  "properties": {
    "historia_id": {"type": "string", "pattern": "\\S"},
    "invest_ok": {"type": "boolean"},
    "preguntas": {
      "type": "array",
      "items": {"type": "string", "minLength": 5, "pattern": "\\S"}
    },
    "escenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titulo", "tipo", "dado", "cuando", "entonces"],
        "properties": {
          "titulo": {"type": "string", "pattern": "\\S"},
          "tipo": {"enum": ["exito", "error", "borde"]},
          "dado": {"$ref": "#/definitions/pasos"},
          "cuando": {"type": "string", "pattern": "\\S"},
          "entonces": {"$ref": "#/definitions/pasos"}
        }
      }
    }
  },
  "definitions": {
    "pasos": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "\\S"}
    }
  },
  "if": {"properties": {"invest_ok": {"const": false}}},
  "then": {
    "properties": {
      "preguntas": {"type": "array", "minItems": 1},
      "escenarios": {"type": "array", "maxItems": 0}
    }
  },
  "else": {"properties": {"escenarios": {"type": "array", "minItems": 1}}}
}
